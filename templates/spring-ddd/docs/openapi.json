{
  "openapi": "3.1.0",
  "info": {
    "description": "Describe what this API is for, in the language of the domain. This text reaches the frontend's generated client and anyone reading Swagger UI, so it is worth a sentence rather than a placeholder.\n\nFailure responses are RFC 7807 problem details, produced centrally by GlobalExceptionHandler: 404 for something that does not exist, 409 for a request the current state does not allow, 400 for one that was never valid.",
    "license": {
      "name": "Unlicensed"
    },
    "title": "app API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as the caller"
    }
  ],
  "paths": {
    "/api/courses/popularity": {
      "get": {
        "operationId": "popularity",
        "parameters": [
          {
            "in": "query",
            "name": "title",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CoursePopularityResponse"
                }
              }
            },
            "description": "The vendor has a popularity for this title"
          },
          "400": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The title is blank"
          },
          "404": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The vendor has no popularity for this title yet"
          },
          "503": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The vendor did not answer"
          }
        },
        "summary": "A course's popularity, as the training catalogue vendor reports it",
        "tags": [
          "course-popularity-controller"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CoursePopularityResponse": {
        "type": "object",
        "properties": {
          "popularity": {
