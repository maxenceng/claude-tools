{
  "name": "app-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dup": "jscpd src",
    "design-check": "impeccable detect src",
    "openapi-client": "openapi-typescript ../docs/openapi.json -o src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "impeccable": "4.1.0",
    "jscpd": "^5.0.14",
    "jsdom": "^30.0.1",
    "msw": "3.0.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
